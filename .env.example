# ========================================
# ATW Timesheet - Environment Variables
# ========================================
# IMPORTANT: Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
#
# Generate secure secrets with: openssl rand -base64 32
# ========================================

# ========================================
# DATABASE
# ========================================
# Development: postgresql://postgres:password@localhost:5432/atw_timesheet?schema=public
# Production: Use strong password and secure connection
DATABASE_URL="postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@localhost:5432/atw_timesheet?schema=public"
DB_PASSWORD="CHANGE_ME_STRONG_PASSWORD"

# ========================================
# APPLICATION
# ========================================
NODE_ENV=development
PORT=8000
# For development: http://localhost:3000
# For production: https://votre-domaine.com
FRONTEND_URL=http://localhost:3000

# ========================================
# JWT AUTHENTICATION
# ========================================
# CRITICAL: Generate strong secrets with: openssl rand -base64 32
# NEVER use these example values in production!
JWT_SECRET="CHANGE_ME_RUN_openssl_rand_base64_32"
REFRESH_TOKEN_SECRET="CHANGE_ME_RUN_openssl_rand_base64_32"
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ========================================
# SMTP EMAIL CONFIGURATION
# ========================================
# Development (Mailtrap Sandbox): sandbox.smtp.mailtrap.io:2525
# Production (Mailtrap Live): live.smtp.mailtrap.io:587
# Gmail: smtp.gmail.com:587 (requires app-specific password)
# IMPORTANT: Never commit real SMTP credentials!
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER="CHANGE_ME_YOUR_SMTP_USERNAME"
SMTP_PASS="CHANGE_ME_YOUR_SMTP_PASSWORD"
SMTP_FROM="noreply@atw-timesheet.com"

# ========================================
# ADMIN REGISTRATION
# ========================================
ADMIN_REGISTRATION_KEY=your_admin_registration_key

# ========================================
# OPTIONAL: MONITORING (Production)
# ========================================
# Sentry for error tracking (optional but recommended for production)
# Get your DSN from: https://sentry.io/
# SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"
# SENTRY_ENVIRONMENT=production

# ========================================
# FRONTEND URL
# ========================================
# Used for CORS and email links
NEXT_PUBLIC_API_URL="http://localhost:8000"
