# Example environment variables for Atw-timesheet API

# ========================================
# DATABASE
# ========================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/stage?schema=public"

# ========================================
# APPLICATION
# ========================================
NODE_ENV=development
PORT=8000
# For development: http://localhost:3000
# For production: https://votre-domaine.com
FRONTEND_URL=http://localhost:3000

# ========================================
# JWT AUTHENTICATION
# ========================================
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here_change_in_production
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here_change_in_production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ========================================
# SMTP EMAIL CONFIGURATION
# ========================================
# For Mailtrap Sandbox (testing): sandbox.smtp.mailtrap.io:2525
# For Mailtrap Live (production): live.smtp.mailtrap.io:587
# For Gmail: smtp.gmail.com:587 (requires app password)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_username
SMTP_PASS=your_mailtrap_password
SMTP_FROM=noreply@atw-timesheet.com

# ========================================
# ADMIN REGISTRATION
# ========================================
ADMIN_REGISTRATION_KEY=your_admin_registration_key

# ========================================
# OPTIONAL: MONITORING (Production)
# ========================================
# SENTRY_DSN=your_sentry_dsn_here
# SENTRY_ENVIRONMENT=production
